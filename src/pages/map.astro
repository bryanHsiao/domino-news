---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClassMap from '../components/ClassMap.astro';
import ClassDirectory from '../components/ClassDirectory.astro';
import ClassIslands from '../components/ClassIslands.astro';
import { useTranslations, localizedPath } from '../i18n/ui';
import { buildCoverageReport } from '../../scripts/lib/coverage';
import rawData from '../../data/ls_classes.json';

const lang = 'zh-TW' as const;
const t = useTranslations(lang);
const raw = rawData as { nodes: any[]; links: any[] };

const report = await buildCoverageReport();
function slugOf(id: string): string | null {
  const posts = report.coverage.get(id);
  return posts && posts.length ? posts[0].slug : null;
}

const nodes = raw.nodes.map((n) => {
  const slug = slugOf(n.id);
  return {
    id: n.id,
    name: n.name,
    cat: n.category,
    ui: !!n.isUI,
    key: !!n.key,
    x: n.x,
    y: n.y,
    url: slug ? localizedPath(lang, `/posts/${slug}`) : null,
    desc: (n.description || '').trim(),
  };
});
const links = raw.links.map((l) => ({
  s: l.source,
  t: l.target,
  via: (l.members || []).map((m: any) => m.name),
}));
const data = { nodes, links };
const coveredCount = nodes.filter((n) => n.url).length;
---

<BaseLayout lang={lang} title={t('nav.map')} description="HCL Domino LotusScript 類別的互動地圖 —— 依類別分區的可讀卡片，點卡片看它回傳什麼、被誰回傳；已寫過的類別可直接點進文章。也可切換成關係散點圖。">
  <div class="map-tabs" role="tablist" aria-label="檢視切換">
    <button class="map-tab on" data-view="dir" type="button">分類檢視</button>
    <button class="map-tab" data-view="graph" type="button">關係圖</button>
    <button class="map-tab" data-view="islands" type="button">島嶼檢視</button>
  </div>

  <div id="mv-dir">
    <ClassDirectory lang={lang} data={data} coveredCount={coveredCount} total={nodes.length} />
  </div>
  <div id="mv-graph" hidden>
    <ClassMap lang={lang} data={data} coveredCount={coveredCount} total={nodes.length} />
  </div>
  <div id="mv-islands" hidden>
    <ClassIslands lang={lang} data={data} coveredCount={coveredCount} total={nodes.length} />
  </div>
</BaseLayout>

<style>
  .map-tabs { display: inline-flex; gap: 4px; margin: 0 0 12px; padding: 4px; border: 1px solid var(--color-border, #e2e0d8); border-radius: 11px; background: var(--color-surface, #fff); }
  .map-tab { font: inherit; font-size: 0.88rem; font-weight: 600; padding: 7px 16px; border: 0; border-radius: 8px; background: transparent; color: var(--color-text-muted, #6b6b6b); cursor: pointer; }
  .map-tab.on { background: var(--color-brand-dark, #0a0a0a); color: #fff; }
  #mv-dir[hidden], #mv-graph[hidden], #mv-islands[hidden] { display: none; }
</style>

<style is:global>
  /* The graph and the islands are immersive views: full page width (not the
     1200px content column) and filling the viewport below the tab row. The
     inline script measures --map-page-w (viewport minus scrollbar) and
     --map-above (where the views start). */
  main:has(> .map-tabs) { padding-top: 1.25rem; }
  #mv-graph, #mv-islands {
    width: var(--map-page-w, 100vw);
    margin-left: calc(50% - var(--map-page-w, 100vw) / 2);
    height: calc(100dvh - var(--map-above, 150px));
    min-height: 480px;
  }
  #mv-graph #cm { height: 100%; min-height: 0; border-radius: 0; border-left: 0; border-right: 0; }
  body:has(#mv-islands) { overflow-x: clip; }
  /* Wide screens: in an immersive view the tab switch floats top-centre over
     the content (like the reference site's toolbar) instead of sitting in its
     own band; the view starts right under the site header. */
  @media (min-width: 1280px) {
    body.map-immersive main:has(> .map-tabs) { padding-top: 0; }
    body.map-immersive .map-tabs { position: absolute; z-index: 30; top: calc(var(--map-hdr, 64px) + 14px); left: 50%; transform: translateX(-50%); margin: 0; box-shadow: 0 8px 26px rgba(33, 29, 29, 0.16); }
  }
</style>

<script is:inline>
  (function () {
    // Size the immersive views: full width without the scrollbar, and tall
    // enough to reach the bottom of the viewport from wherever they start.
    function sizeViews() {
      var html = document.documentElement;
      var hdr = document.querySelector('header.site-header');
      html.style.setProperty('--map-page-w', html.clientWidth + 'px');
      if (hdr) html.style.setProperty('--map-hdr', hdr.offsetHeight + 'px');
      var view = ['mv-graph', 'mv-islands'].map(function (id) { return document.getElementById(id); }).filter(function (el) { return el && !el.hidden; })[0];
      if (view) html.style.setProperty('--map-above', Math.round(view.getBoundingClientRect().top + window.scrollY) + 'px');
    }
    function initMapTabs() {
      var tabs = document.querySelectorAll('.map-tab');
      if (!tabs.length) return;
      var dir = document.getElementById('mv-dir'), graph = document.getElementById('mv-graph'), islands = document.getElementById('mv-islands');
      if (!dir || !graph || !islands || dir.dataset.tabsReady) return;
      dir.dataset.tabsReady = '1';
      sizeViews();
      if (!window.__mapSizeBound) {
        window.__mapSizeBound = true;
        window.addEventListener('resize', sizeViews);
      }
      Array.prototype.forEach.call(tabs, function (b) {
        b.addEventListener('click', function () {
          Array.prototype.forEach.call(tabs, function (x) { x.classList.toggle('on', x === b); });
          var v = b.dataset.view;
          dir.hidden = v !== 'dir';
          graph.hidden = v !== 'graph';
          islands.hidden = v !== 'islands';
          document.body.classList.toggle('map-immersive', v !== 'dir');
          if (v === 'graph' || v === 'islands') {
            window.scrollTo(0, 0);
            sizeViews();
            window.dispatchEvent(new Event('resize'));
          }
        });
      });
    }
    document.addEventListener('astro:page-load', initMapTabs);
  })();
</script>
