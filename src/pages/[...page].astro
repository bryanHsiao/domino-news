---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import Pagination from '../components/Pagination.astro';
import { getPostsByLang } from '../lib/posts';
import { useTranslations } from '../i18n/ui';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getPostsByLang('zh-TW');
  return paginate(
    posts.map((p) => ({
      slug: p.data.slug,
      title: p.data.title,
      description: p.data.description,
      pubDate: p.data.pubDate,
      tags: p.data.tags,
      cover: p.data.cover,
    })),
    { pageSize: 9 }
  );
}) satisfies GetStaticPaths;

const lang = 'zh-TW' as const;
const t = useTranslations(lang);
const { page } = Astro.props;
const isFirstPage = page.currentPage === 1;
const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const siteOrigin = Astro.site?.origin ?? 'https://bryanhsiao.github.io';
const siteRoot = `${siteOrigin}${base}/`;

// Give paginated pages (/2/, /3/…) a page-numbered title + description so they
// don't all share the homepage's title (a duplicate-title SEO problem). The
// first page keeps the default homepage title/description.
const metaTitle = isFirstPage ? undefined : `文章一覽（第 ${page.currentPage}／${page.lastPage} 頁）`;
const metaDesc = isFirstPage ? undefined : `HCL Domino 日報的文章列表，第 ${page.currentPage} 頁（共 ${page.lastPage} 頁）。`;

// Home-only JSON-LD: WebSite with SearchAction so Google can show a
// sitelinks search box for the site. URL template uses /search/?q=…;
// search.astro reads the q parameter and pre-fills the Pagefind input.
const homeJsonLd = isFirstPage
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'HCL Domino Daily',
      alternateName: 'HCL Domino Daily',
      url: siteRoot,
      description: t('site.description'),
      inLanguage: 'zh-TW',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${siteRoot}search/?q={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
      publisher: {
        '@type': 'Organization',
        name: 'HCL Domino Daily',
        url: siteRoot,
        logo: {
          '@type': 'ImageObject',
          url: `${siteRoot}logo.png`,
        },
      },
    }
  : undefined;
---

<BaseLayout lang={lang} title={metaTitle} description={metaDesc} jsonLd={homeJsonLd}>
  {
    isFirstPage && (
      <>
        <div class="hero" aria-hidden="true">
          <img src={`${base}/covers/welcome.webp`} alt="" loading="eager" />
        </div>
        <h1>{t('site.title')} —<wbr /><span style="white-space: nowrap"> {t('site.tagline')}</span></h1>
        <p class="lead">{t('site.description')}</p>
        <h2 id="latest" class="home-latest">{t('home.latest')}</h2>
      </>
    )
  }

  <PostList lang={lang} posts={page.data} />

  <Pagination
    lang={lang}
    currentPage={page.currentPage}
    lastPage={page.lastPage}
    prevUrl={page.url.prev}
    nextUrl={page.url.next}
    basePath=""
  />
</BaseLayout>
