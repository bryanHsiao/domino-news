---
import type { Lang } from '../i18n/ui';
import type { ClassArticle, XPagesMember } from '../lib/classArticles';

interface IslandNode {
  id: string;
  name: string;
  cat: string;
  ui: boolean;
  key: boolean;
  url: string | null;
  desc?: string;
}
interface IslandData {
  nodes: IslandNode[];
  links: { s: string; t: string; via?: string[] }[];
}
interface Props {
  lang: Lang;
  data: IslandData;
  /** class id -> its articles, LS → Java → SSJS (src/lib/classArticles.ts) */
  articles: Record<string, ClassArticle[]>;
  /** buildings on the XPages / web-layer island */
  xpages: XPagesMember[];
  /** buildings in the OpenNTF harbour on the shore */
  harbour: XPagesMember[];
  coveredCount: number;
  total: number;
}
const { lang, data, articles, xpages, harbour, coveredCount, total } = Astro.props;

// The class houses carry their articles (LS plus any Java / SSJS residents,
// one door sign each). The XPages / web-layer posts become a separate island:
// one building per post, standing only in this view — the shared class data
// (directory / graph) stays the 97 LotusScript classes, untouched.
const ISLAND = 'XPages';
const classNodes = data.nodes.map(({ id, name, cat, ui, key, url, desc }) => ({ id, name, cat, ui, key, url, desc: desc || '', articles: articles[id] || [] }));
const xpagesNodes = xpages.map((m) => ({ id: 'xpages:' + m.slug, name: m.name, cat: ISLAND, ui: true, key: false, url: m.url, desc: m.desc || '', articles: [m.article], island: true }));
// The OpenNTF community posts stand in a harbour town on the lake shore, not
// on an island: the community supplies tools, it isn't part of the API.
const HARBOUR = 'OpenNTF';
const harbourNodes = harbour.map((m) => ({ id: 'openntf:' + m.slug, name: m.name, cat: HARBOUR, ui: false, key: false, url: m.url, desc: m.desc || '', articles: [m.article], island: true, harbour: true }));
const nodes = [...classNodes, ...xpagesNodes, ...harbourNodes];

// Island numbering: the six core-containment categories first (fixed spine
// order, same as ClassDirectory), then the rest by class count descending.
// Where the islands go is decided in ./islands/layout.js from the class links
// (related categories sit a bridge apart); the XPages island has no class
// links, so it stands out at sea at the end of a long bridge, and the OpenNTF
// harbour (numbered last) sits on the shore, linked by boats.
const CORE = ['Session', 'Database', 'View', 'Document', 'Item', 'Rich Text'];
const counts: Record<string, number> = {};
nodes.forEach((n) => (counts[n.cat] = (counts[n.cat] || 0) + 1));
const cats = [
  ...CORE.filter((c) => counts[c]),
  ...Object.keys(counts)
    .filter((c) => !CORE.includes(c) && c !== HARBOUR)
    .sort((a, b) => counts[b] - counts[a] || a.localeCompare(b)),
  ...(counts[HARBOUR] ? [HARBOUR] : []),
];
const islandCount = cats.filter((c) => c !== HARBOUR).length;
const payload = { nodes, cats, links: data.links };

const T =
  lang === 'zh-TW'
    ? {
        brand: 'HCL Domino',
        name: '類別島嶼',
        eyebrow: '類別索引',
        indexLabel: '類別索引',
        langs: 'LotusScript · Java · SSJS',
        meta: '{i} 座島／{c} 個類別',
        btnPlates: '名牌',
        platesTip: '顯示或隱藏島嶼名牌',
        tools: '地圖操作',
        btnHome: '全景',
        btnSearch: '搜尋',
        btnList: '清單',
        timeGroup: '時段',
        times: { dawn: '清晨', day: '白天', dusk: '黃昏', night: '夜晚' },
        timeShort: { dawn: '晨', day: '日', dusk: '昏', night: '夜' },
        bird: '俯瞰',
        birdLong: '俯瞰',
        btnView: '檢視',
        viewTitle: '時段與視角',
        linksGroup: '關聯線',
        linkModes: { off: '關', focus: '選取', all: '全部' },
        linkTips: { off: '不顯示關聯線', focus: '選島或指著房子時，亮出相關的關聯線', all: '顯示全部 {n} 條關聯線' },
        btnLinks: '連線',
        btnPause: '暫停',
        btnPlay: '繼續',
        pauseTip: '暫停行人、船與海面',
        listTitle: '所有島嶼',
        noMatch: '沒有符合的類別',
        langOther: '社群',
        sub: '每個 category 一座島，類別越多島越大；有關聯的島之間才有橋，橋越寬關聯越多，捧箱子的人在有關聯的島之間搬運。有 Java／SSJS 文章的房子屋頂插一支對應顏色的旗（藍＝Java、綠＝SSJS）；門口的「i」告示牌一面代表一篇文章（圓章顏色＝文章語言）；XPages／網頁層概念文另成一座外海島，靠長橋連過去；OpenNTF 社群文在岸邊的港口，船從那裡開往各島。拖曳轉看、滾輪縮放；點島看清單與關聯線，點房子看類別介紹，點告示牌看文章預覽，指著房子或橋看關聯。',
        covered: '已涵蓋',
        search: '搜尋類別…',
        reset: '重設視角',
        legBe: '後端',
        legUi: 'UI',
        legUn: '尚未寫成文章',
        legKey: 'key class',
        legFlagTip: '有 Java／SSJS 文章的房子，屋頂插一支對應顏色的旗',
        hint: '拖曳轉看 · 點島看清單',
        panelCount: ' 個類別',
        panelCountIsland: ' 篇文章',
        close: '關閉',
        tipBe: '後端',
        tipUi: 'UI',
        tipKey: 'key class',
        tipUn: '尚未寫成文章',
        tipInfo: '點一下看類別介紹',
        tipArticle: '文章',
        tipPreview: '點一下看文章預覽',
        cardClass: '類別',
        cardArticle: '文章',
        goArticle: '前往文章 →',
        classArticles: '這個類別的文章',
        noArticle: '這個類別還沒有文章',
        noDesc: '（沒有說明）',
        about: '關於',
        moreArticles: '同一類別的其他文章',
        tipRel: ' 條關聯（A 的方法／屬性回傳 B）',
        tipPath: '步道：兩個類別沒有直接關聯，經這裡可走到其他島',
        tipMore: '還有 {n} 條',
        tipLinks: '{n} 條關聯',
        relTitle: '與其他島的關聯',
        relBridge: '有橋直達',
        relWalk: '經其他島步行',
        fbTitle: '這個瀏覽器無法顯示 3D 島嶼',
        fbBody: '你的瀏覽器或裝置不支援 WebGL。島嶼檢視需要 WebGL 才能渲染。',
        fbBtn: '改用分類檢視',
        loading: '載入 3D 島嶼中…',
      }
    : {
        brand: 'HCL Domino',
        name: 'Class Islands',
        eyebrow: 'Class index',
        indexLabel: 'Class index',
        langs: 'LotusScript · Java · SSJS',
        meta: '{i} islands / {c} classes',
        btnPlates: 'Labels',
        platesTip: 'Show or hide the island name plates',
        tools: 'Map tools',
        btnHome: 'Fit',
        btnSearch: 'Find',
        btnList: 'List',
        timeGroup: 'Time of day',
        times: { dawn: 'Dawn', day: 'Day', dusk: 'Dusk', night: 'Night' },
        timeShort: { dawn: 'Dawn', day: 'Day', dusk: 'Dusk', night: 'Night' },
        bird: 'Top',
        birdLong: 'Top view',
        btnView: 'View',
        viewTitle: 'Time and view',
        linksGroup: 'Links',
        linkModes: { off: 'Off', focus: 'Selected', all: 'All' },
        linkTips: { off: 'Hide the relation lines', focus: 'Show the links of the selected island or the house under the pointer', all: 'Show all {n} relation lines' },
        btnLinks: 'Links',
        btnPause: 'Pause',
        btnPlay: 'Play',
        pauseTip: 'Pause the walkers, boats and water',
        listTitle: 'All islands',
        noMatch: 'No matching class',
        langOther: 'Community',
        sub: 'One island per category, bigger for more classes; bridges only join related islands, wider for more links, and porters carry boxes between related islands. A house with a Java / SSJS article flies a roof flag in that colour (blue = Java, green = SSJS); each “i” sign at a door is one article (its badge in the article’s language colour); the web-layer XPages posts form their own island out at sea, reached by a long bridge; the OpenNTF community posts stand in a harbour on the shore, its boats sailing out to the islands. Drag to orbit, scroll to zoom; click an island for its list and relation lines, a house for the class overview, a sign at its door for an article preview; hover a house or bridge for its links.',
        covered: 'covered',
        search: 'Search classes…',
        reset: 'Reset view',
        legBe: 'Backend',
        legUi: 'UI',
        legUn: 'Not written yet',
        legKey: 'Key class',
        legFlagTip: 'A house with a Java / SSJS article flies a flag in that colour',
        hint: 'Drag to orbit · tap an island',
        panelCount: ' classes',
        panelCountIsland: ' posts',
        close: 'Close',
        tipBe: 'Backend',
        tipUi: 'UI',
        tipKey: 'key class',
        tipUn: 'not written yet',
        tipInfo: 'Click for the class overview',
        tipArticle: 'Article',
        tipPreview: 'Click for a preview',
        cardClass: 'Class',
        cardArticle: 'Article',
        goArticle: 'Open article →',
        classArticles: 'Articles on this class',
        noArticle: 'No article on this class yet',
        noDesc: '(no description)',
        about: 'About',
        moreArticles: 'More on this class',
        tipRel: ' links (a method/property of A returns B)',
        tipPath: 'Footpath: these categories have no direct link; it lets you walk on to other islands',
        tipMore: '+{n} more',
        tipLinks: '{n} links',
        relTitle: 'Related islands',
        relBridge: 'bridge',
        relWalk: 'via other islands',
        fbTitle: "This browser can't show the 3D islands",
        fbBody: 'Your browser or device has no WebGL support. The islands view needs WebGL to render.',
        fbBtn: 'Use the grouped view',
        loading: 'Loading the 3D islands…',
      };
// What the coverage pill counts (shown on hover).
const statTip =
  lang === 'zh-TW'
    ? `${total} 個 LotusScript 類別中，已有 ${coveredCount} 個寫成文章（有文章連到該類別或它的屬性／方法的官方文件）`
    : `${coveredCount} of the ${total} LotusScript classes already have an article (a post links to the class or one of its members' HCL docs)`;
---

<div
  id="ci"
  data-count={T.panelCount}
  data-count-island={T.panelCountIsland}
  data-close={T.close}
  data-tip-be={T.tipBe}
  data-tip-ui={T.tipUi}
  data-tip-key={T.tipKey}
  data-tip-un={T.tipUn}
  data-tip-info={T.tipInfo}
  data-tip-article={T.tipArticle}
  data-tip-preview={T.tipPreview}
  data-card-class={T.cardClass}
  data-card-article={T.cardArticle}
  data-go-article={T.goArticle}
  data-class-articles={T.classArticles}
  data-no-article={T.noArticle}
  data-no-desc={T.noDesc}
  data-about={T.about}
  data-more-articles={T.moreArticles}
  data-tip-rel={T.tipRel}
  data-tip-path={T.tipPath}
  data-lang-other={T.langOther}
  data-tip-more={T.tipMore}
  data-rel-title={T.relTitle}
  data-rel-bridge={T.relBridge}
  data-rel-walk={T.relWalk}
  data-list-title={T.listTitle}
  data-no-match={T.noMatch}
  data-times={JSON.stringify(T.times)}
  data-tip-links={T.tipLinks}
  data-pause={T.btnPause}
  data-play={T.btnPlay}
>
  <div class="ci-stage">
    <canvas id="ci-canvas"></canvas>
    <div id="ci-labels" class="ci-labels"></div>
    <div id="ci-tip" class="ci-tip" hidden></div>

    <!-- Brand card top-left (like the reference's), title and coverage only;
         the view controls live in the toolbar, search and lists in the index. -->
    <div class="ci-card">
      <h1><span class="ci-brand">{T.brand}</span> <span class="ci-name">{T.name}</span></h1>
      <span class="ci-stat" title={statTip}><b>{coveredCount}</b> / {total} {T.covered}</span>
    </div>

    <!-- View toolbar (wider screens): centred over the scene like the
         reference's, time of day and relation lines on top, tools below.
         Phones use the tools column instead. -->
    <div class="ci-bar" role="toolbar" aria-label={T.tools}>
      <!-- one row, as the reference: time of day as icons, the relation
           lines, then the icon buttons -->
      <div class="ci-time ci-sky" role="group" aria-label={T.timeGroup}>
        <button type="button" data-time="dawn" title={T.times.dawn} aria-label={T.times.dawn}><svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12.5h12M4.5 12.5a3.5 3.5 0 0 1 7 0M8 2.5v4M6.2 4.3L8 2.5l1.8 1.8"></path></svg></button>
        <button type="button" data-time="day" class="on" title={T.times.day} aria-label={T.times.day}><svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="2.8"></circle><path d="M8 1.6v1.5M8 12.9v1.5M1.6 8h1.5M12.9 8h1.5M3.5 3.5l1 1M11.5 11.5l1 1M3.5 12.5l1-1M11.5 4.5l1-1"></path></svg></button>
        <button type="button" data-time="dusk" title={T.times.dusk} aria-label={T.times.dusk}><svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12.5h12M4.5 12.5a3.5 3.5 0 0 1 7 0M8 2.5v4M6.2 4.7L8 6.5l1.8-1.8"></path></svg></button>
        <button type="button" data-time="night" title={T.times.night} aria-label={T.times.night}><svg viewBox="0 0 16 16" width="17" height="17" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12.6 10.1A5.2 5.2 0 0 1 5.9 3.4a5.2 5.2 0 1 0 6.7 6.7z"></path></svg></button>
      </div>
      <div class="ci-time ci-links" role="group" aria-label={T.linksGroup}>
        <span class="ci-seg-lbl">{T.linksGroup}</span>
        {(['off', 'focus', 'all'] as const).map((k) => (
          <button type="button" data-links={k} class={k === 'focus' ? 'on' : undefined} title={T.linkTips[k].replace('{n}', String(data.links.length))}>{T.linkModes[k]}</button>
        ))}
      </div>
      <div class="ci-icons">
        <button type="button" data-act="home" title={T.reset}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M4 12L12 4M6.5 4H12v5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg><span>{T.btnHome}</span></button>
        <button type="button" data-act="plates" aria-pressed="true" title={T.platesTip}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="2" y="4.5" width="12" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M5 8h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg><span>{T.btnPlates}</span></button>
        <button type="button" data-act="pause" aria-pressed="false" title={T.pauseTip}><svg class="ci-pause-ic" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path class="ic-pause" d="M5 3.5v9M11 3.5v9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path><path class="ic-play" d="M5 3.2v9.6L13 8z" fill="currentColor"></path></svg><span class="ci-pause-name">{T.btnPause}</span></button>
        <button type="button" data-act="bird" aria-pressed="false" title={T.birdLong}><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><rect x="2.5" y="2.5" width="11" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 2.5v11M2.5 8h11" stroke="currentColor" stroke-width="1.2"></path></svg><span>{T.bird}</span></button>
      </div>
    </div>

    <!-- Small screens: map tools as a column of small buttons top-right (like
         the reference site's toolbar); the page's view switch stacks below. -->
    <nav class="ci-tools" data-map-tools aria-label={T.tools}>
      <button type="button" data-act="home"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M4 12L12 4M6.5 4H12v5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>{T.btnHome}</button>
      <button type="button" data-act="search" aria-expanded="false"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"></circle><path d="M10.5 10.5L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>{T.btnSearch}</button>
      <button type="button" data-act="list"><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2.5 4h11M2.5 8h11M2.5 12h11" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>{T.btnList}</button>
      <button type="button" data-act="view" aria-expanded="false" title={T.viewTitle}><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path d="M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path></svg>{T.btnView}</button>
      <button type="button" data-act="links" aria-pressed="false" title={T.linkTips.all.replace('{n}', String(data.links.length))}><svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M2.5 12.5C4 5 12 5 13.5 12.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="2.2 1.8"></path><circle cx="2.5" cy="12.5" r="1.4" fill="currentColor"></circle><circle cx="13.5" cy="12.5" r="1.4" fill="currentColor"></circle></svg>{T.btnLinks}</button>
      <button type="button" data-act="pause" aria-pressed="false" title={T.pauseTip}><svg class="ci-pause-ic" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path class="ic-pause" d="M5 3.5v9M11 3.5v9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path><path class="ic-play" d="M5 3.2v9.6L13 8z" fill="currentColor"></path></svg><span class="ci-pause-name">{T.btnPause}</span></button>
    </nav>
    <!-- phones: the 檢視 button opens time of day + bird's-eye beside the column -->
    <div class="ci-pop" id="ci-viewpop" hidden>
      <div class="ci-time" role="group" aria-label={T.timeGroup}>
        {(['dawn', 'day', 'dusk', 'night'] as const).map((k) => (
          <button type="button" data-time={k} class={k === 'day' ? 'on' : undefined} title={T.times[k]}>{T.timeShort[k]}</button>
        ))}
      </div>
      <button type="button" class="ci-bird" data-act="bird" aria-pressed="false"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="2.5" y="2.5" width="11" height="11" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M8 2.5v11M2.5 8h11" stroke="currentColor" stroke-width="1.2"></path></svg>{T.birdLong}</button>
      <button type="button" class="ci-bird" data-act="plates" aria-pressed="true"><svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><rect x="2" y="4.5" width="12" height="7" rx="2" fill="none" stroke="currentColor" stroke-width="1.5"></rect><path d="M5 8h6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>{T.btnPlates}</button>
    </div>

    <div id="ci-loading" class="ci-loading" hidden>{T.loading}</div>

    <div id="ci-fallback" class="ci-fallback" hidden>
      <h2>{T.fbTitle}</h2>
      <p>{T.fbBody}</p>
      <button id="ci-fb-btn" type="button">{T.fbBtn}</button>
    </div>

    <div id="ci-hint" class="ci-hint" data-hint={T.hint}></div>

    <div class="ci-legend">
      <span><i class="sw be"></i>{T.legBe}</span>
      <span><i class="sw ui"></i>{T.legUi}</span>
      <span><i class="sw un"></i>{T.legUn}</span>
      <span><i class="sw key"></i>{T.legKey}</span>
      <span class="ci-leg-sep" aria-hidden="true"></span>
      <span title={T.legFlagTip}><i class="sw flag java"></i>Java</span>
      <span title={T.legFlagTip}><i class="sw flag ssjs"></i>SSJS</span>
    </div>
  </div>

  <!-- Index panel docked on the right (like the reference's policy index):
       what the map covers, search, then the island list — which turns into
       an island's classes, a class overview or an article preview. On phones
       the head folds away (search opens under the brand card) and the panel
       becomes a bottom sheet. -->
  <aside class="ci-index" aria-label={T.indexLabel}>
    <div class="ci-ix-head">
      <div class="ci-eyebrow">{T.eyebrow}</div>
      <div class="ci-langs">{T.langs}</div>
      <p class="ci-ix-meta">{T.meta.replace('{i}', String(islandCount)).replace('{c}', String(total))}</p>
      <p class="ci-sub">{T.sub}</p>
      <input id="ci-q" type="search" placeholder={T.search} autocomplete="off" />
    </div>
    <div id="ci-panel" class="ci-panel" hidden></div>
  </aside>
</div>

<script type="application/json" id="ci-data" set:html={JSON.stringify(payload)}></script>

<style is:global>
  /* Page chrome (header, controls) follows the site theme; everything inside
     the stage follows the always-daylight scene: cream paper, coral, ink. */
  #ci {
    --cbg: #faf9f6; --cpanel: #fff; --cink: #1a1a1a; --cmuted: #6b6b6b; --cline: #e2e0d8; --cgold: #d99000;
    --paper: #fff8f4; --ink: #211d1d; --ink-mut: #78685e; --coral: #db6a41; --butter: #fcea8b; --hair: rgba(33, 29, 29, 0.18);
    --roof-be: #4f86c6; --roof-ui: #8b6fd1; --roof-un: #a8a29a; --roof-key: #e9b444;
    position: relative; display: flex; height: 100%; min-height: 480px; overflow: hidden; background: var(--cbg); color: var(--cink);
  }
  /* width of the docked index panel (map.astro keeps the view switch clear of it) */
  :root { --ci-ix-w: clamp(270px, 24vw, 340px); }
  #ci * { box-sizing: border-box; }

  #ci .ci-stage { position: relative; flex: 1 1 auto; min-width: 0; height: 100%; overflow: hidden; background: linear-gradient(180deg, #cfe6ee 0%, #f4eee3 55%, #8fc3c9 100%); color: var(--ink); }

  /* Brand card top-left: big coral brand, the view's name, coverage. */
  #ci .ci-card { position: absolute; top: 14px; left: 14px; z-index: 7; display: flex; flex-direction: column; align-items: flex-start; gap: 7px; max-width: calc(100% - 28px);
    background: rgba(255, 248, 244, 0.95); border: 1px solid var(--hair); border-radius: 16px; padding: 11px 16px 12px; box-shadow: 0 8px 26px rgba(33, 29, 29, 0.14); }
  #ci .ci-card h1 { margin: 0; display: flex; flex-direction: column; line-height: 1.02; color: var(--ink); }
  #ci .ci-brand { font-size: 26px; font-weight: 800; letter-spacing: -0.03em; }
  #ci .ci-name { margin-top: 3px; font-size: 14px; font-weight: 700; letter-spacing: 0.08em; }
  #ci .ci-stat { flex: none; display: inline-flex; align-items: baseline; gap: 4px; background: var(--ink); color: #d9d4cc; padding: 4px 10px; border-radius: 999px; font-size: 11px; white-space: nowrap; }
  #ci .ci-stat b { color: #fbbf24; font-size: 15px; font-variant-numeric: tabular-nums; }

  /* Wide screens: one row of pills beside the brand card (the reference's
     toolbar). When that row would run into the view tabs, the script sets
     .bar-col and the column of buttons below takes over. */
  #ci .ci-bar { position: absolute; z-index: 7; top: 14px; left: 248px; display: flex; flex-wrap: nowrap; align-items: center; gap: 8px; }
  #ci .ci-bar .ci-time { align-items: center; gap: 2px; padding: 5px; background: rgba(255, 248, 244, 0.95); border-radius: 999px; box-shadow: 0 6px 18px rgba(33, 29, 29, 0.12); }
  #ci .ci-bar .ci-time button { height: 36px; padding: 0 12px; border-radius: 999px; }
  #ci .ci-bar .ci-sky button { display: grid; place-items: center; width: 36px; padding: 0; }
  #ci .ci-icons { display: flex; gap: 2px; padding: 4px; background: rgba(255, 248, 244, 0.95); border: 1px solid var(--hair); border-radius: 999px; box-shadow: 0 8px 22px rgba(33, 29, 29, 0.14); }
  #ci .ci-icons button { display: flex; flex-direction: column; align-items: center; gap: 3px; min-width: 50px; padding: 5px 8px 4px; border: 0; border-radius: 999px; background: transparent; color: var(--ink);
    font: 600 11px/1 system-ui, -apple-system, 'Noto Sans TC', sans-serif; cursor: pointer; }
  #ci .ci-icons button:hover { background: rgba(33, 29, 29, 0.07); }
  #ci .ci-icons button[data-act='pause'][aria-pressed='true'], #ci .ci-icons button[data-act='bird'][aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  #ci .ci-icons [data-act='plates'][aria-pressed='false'] svg { opacity: 0.4; }
  #ci.no-plates .ci-labels { display: none; }

  /* Index panel docked on the right: head (what the map covers + search),
     then the panel body (island list / island / class / article). */
  #ci .ci-index { flex: none; position: relative; z-index: 6; width: var(--ci-ix-w); height: 100%; display: flex; flex-direction: column; background: var(--paper); color: var(--ink); border-left: 1px solid var(--hair); box-shadow: -10px 0 30px rgba(33, 29, 29, 0.08); }
  #ci .ci-ix-head { flex: none; padding: 18px 18px 14px; border-bottom: 1px solid var(--hair); }
  #ci .ci-eyebrow { font: 700 10.5px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: 0.14em; text-transform: uppercase; color: var(--coral); }
  /* the languages the map spans: a short chip, not a sentence */
  #ci .ci-langs { display: inline-block; margin: 8px 0 6px; padding: 2px 9px; border: 1px solid var(--coral); border-radius: 999px; color: var(--coral); font: 600 11px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: nowrap; }
  #ci .ci-ix-meta { margin: 0; font: 600 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--ink-mut); }
  #ci .ci-sub { margin: 6px 0 12px; font-size: 11.5px; line-height: 1.55; color: var(--ink-mut); }
  #ci #ci-q { display: block; width: 100%; font: inherit; font-size: 13px; padding: 9px 12px; border: 1px solid var(--hair); border-radius: 10px; background: #fff; color: var(--ink); }
  #ci #ci-q:focus { outline: none; border-color: var(--coral); }
  #ci .ci-time { display: inline-flex; border: 1px solid var(--hair); border-radius: 8px; overflow: hidden; background: #fff; }
  #ci .ci-time button { font: inherit; font-size: 12px; padding: 5px 11px; border: 0; background: transparent; color: var(--ink-mut); cursor: pointer; }
  #ci .ci-time button.on { background: var(--ink); color: var(--paper); }
  #ci .ci-bird { display: inline-flex; align-items: center; gap: 5px; font: inherit; font-size: 12px; padding: 5px 11px; border: 1px solid var(--hair); border-radius: 8px; background: #fff; color: var(--ink); cursor: pointer; }
  #ci .ci-bird[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  #ci .ci-seg-lbl { align-self: center; padding: 0 4px 0 10px; font-size: 12px; color: var(--ink-mut); white-space: nowrap; }
  /* pause ⇄ play icon */
  #ci .ci-pause-ic .ic-play, #ci [aria-pressed='true'] .ci-pause-ic .ic-pause { display: none; }
  #ci [aria-pressed='true'] .ci-pause-ic .ic-play { display: inline; }
  #ci .ci-pop, #ci .ci-pop[hidden] { display: none; }
  #ci #ci-canvas { width: 100%; height: 100%; display: block; cursor: grab; touch-action: none; }
  #ci #ci-canvas:active { cursor: grabbing; }

  #ci .ci-labels { position: absolute; inset: 0; pointer-events: none; z-index: 3; overflow: hidden; }
  #ci .ci-lbl { position: absolute; left: 0; top: 0; pointer-events: auto; cursor: pointer; white-space: nowrap; display: flex; align-items: center; gap: 6px;
    font: 600 11.5px/1.15 system-ui, -apple-system, 'Noto Sans TC', sans-serif; color: var(--ink); background: rgba(255, 248, 244, 0.94);
    border: 1px solid rgba(33, 29, 29, 0.21); border-radius: 5px; padding: 6px 9px; box-shadow: 0 2px 0 rgba(33, 29, 29, 0.08); transition: opacity 0.2s, background-color 0.2s; }
  #ci .ci-lbl b { color: var(--coral); font: 700 10px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  #ci .ci-lbl i { font: 600 10px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-style: normal; color: var(--ink-mut); }
  #ci .ci-lbl:hover { border-color: var(--coral); }
  #ci .ci-lbl.sel { background: var(--ink); color: var(--paper); border-color: var(--coral); }
  #ci .ci-lbl.sel b { color: var(--butter); } #ci .ci-lbl.sel i { color: #cfc6bf; }
  #ci .ci-lbl.dim { opacity: 0.28; }

  #ci .ci-tip { position: absolute; left: 0; top: 0; z-index: 8; pointer-events: none; display: flex; flex-direction: column; gap: 2px; max-width: 260px;
    background: rgba(255, 248, 244, 0.97); border: 1px solid var(--hair); border-radius: 8px; padding: 7px 10px; box-shadow: 0 6px 18px rgba(33, 29, 29, 0.16); font-size: 12px; line-height: 1.35; }
  #ci .ci-tip b { font-size: 13px; }
  #ci .ci-tip span { color: var(--ink-mut); font-size: 11px; }
  #ci .ci-tip em { font-style: normal; color: var(--coral); font-weight: 600; font-size: 11px; }
  #ci .ci-tip code { font: 10.5px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  #ci .ci-tip[data-kind='bridge'] { max-width: 380px; }

  #ci .ci-panel .prel { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--hair); }
  #ci .ci-panel .prel-lbl { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-mut); }
  #ci .ci-panel .prel-key { font-size: 0.7rem; color: var(--ink-mut); margin: 3px 0 8px; }
  #ci .ci-panel .prel-chips { display: flex; flex-wrap: wrap; gap: 5px; }
  #ci .ci-panel .prel-chip { display: inline-flex; align-items: center; gap: 5px; font: inherit; font-size: 0.78rem; padding: 4px 8px; border-radius: 7px; border: 1px dashed var(--hair); background: transparent; color: var(--ink); cursor: pointer; }
  #ci .ci-panel .prel-chip.br { border-style: solid; background: #fff; }
  #ci .ci-panel .prel-chip:hover { border-color: var(--coral); }
  #ci .ci-panel .prel-chip .ic { color: var(--coral); font-weight: 700; }
  #ci .ci-panel .prel-chip i { font-style: normal; font: 600 10px ui-monospace, monospace; color: var(--ink-mut); }

  #ci .ci-loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; z-index: 4; color: var(--ink-mut); font-size: 14px; }

  #ci .ci-fallback { position: absolute; inset: 0; z-index: 10; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; text-align: center; padding: 30px; background: var(--cbg); color: var(--cink); }
  #ci .ci-fallback h2 { margin: 0; font-size: 17px; font-weight: 650; }
  #ci .ci-fallback p { margin: 0; color: var(--cmuted); font-size: 13.5px; max-width: 42ch; }
  #ci .ci-fallback button { margin-top: 6px; font: inherit; font-size: 13px; font-weight: 600; padding: 9px 18px; border: 0; border-radius: 9px; background: var(--color-brand-dark, #0a0a0a); color: var(--color-brand, #fbbf24); cursor: pointer; }

  #ci .ci-panel { flex: 1 1 auto; min-height: 0; overflow: auto; padding: 14px 18px 20px; color: var(--ink); }
  #ci .ci-panel .pclose { float: right; border: 0; background: transparent; color: var(--ink-mut); cursor: pointer; font-size: 1.15rem; line-height: 1; padding: 2px 4px; }
  #ci .ci-panel .pnum { font: 700 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--coral); }
  #ci .ci-panel h3 { font-size: 1.1rem; font-weight: 720; letter-spacing: -0.01em; margin: 2px 0; color: var(--ink); }
  #ci .ci-panel .pmeta { font-size: 0.76rem; color: var(--ink-mut); margin-bottom: 12px; font-variant-numeric: tabular-nums; }
  #ci .ci-panel .plist { display: flex; flex-direction: column; gap: 6px; }
  #ci .ci-panel .pcls { text-align: left; border: 1px solid var(--hair); background: #fff; border-radius: 9px; padding: 8px 10px; font: inherit; cursor: pointer; color: var(--ink); display: flex; align-items: center; gap: 8px; }
  #ci .ci-panel .pcls:hover { border-color: var(--coral); }
  #ci .ci-panel .pcls.un { color: var(--ink-mut); border-style: dashed; cursor: default; }
  #ci .ci-panel .pcls .dot { width: 10px; height: 10px; border-radius: 3px; flex: none; }
  #ci .ci-panel .pcls .nm { font-size: 0.88rem; font-weight: 600; flex: 1; letter-spacing: -0.01em; }
  #ci .ci-panel .pcls .st { color: var(--roof-key); font-size: 0.75rem; }
  #ci .ci-panel .pcls .go { font-size: 0.72rem; color: var(--coral); }

  /* class overview + article preview cards (same panel) */
  #ci .ci-panel .pkind { display: flex; align-items: center; gap: 6px; font: 700 11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--coral); }
  #ci .ci-panel .pcat { font: 600 11px system-ui, -apple-system, 'Noto Sans TC', sans-serif; color: var(--ink); background: #fff; border: 1px solid var(--hair); border-radius: 999px; padding: 2px 9px; cursor: pointer; }
  #ci .ci-panel .pcat:hover { border-color: var(--coral); }
  #ci .ci-panel .ptags { display: flex; flex-wrap: wrap; gap: 5px; margin: 6px 0 10px; }
  #ci .ci-panel .ptag { display: inline-flex; align-items: center; gap: 5px; font-size: 0.72rem; color: var(--ink-mut); border: 1px solid var(--hair); border-radius: 6px; padding: 2px 7px; background: #fff; }
  #ci .ci-panel .ptag .dot { width: 8px; height: 8px; border-radius: 2px; flex: none; }
  #ci .ci-panel .pdesc { margin: 0 0 12px; font-size: 0.84rem; line-height: 1.55; color: var(--ink); }
  #ci .ci-panel .pdesc.none { color: var(--ink-mut); }
  #ci .ci-panel .pgo { display: inline-flex; align-items: center; font-size: 0.8rem; font-weight: 650; color: var(--coral); text-decoration: none; border: 1px solid var(--coral); border-radius: 8px; padding: 6px 12px; background: transparent; }
  #ci .ci-panel .pgo:hover { background: var(--coral); color: #fff; }
  #ci .ci-panel .psec { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--hair); }
  #ci .ci-panel .part { display: flex; flex-direction: column; gap: 2px; width: 100%; text-align: left; border: 1px solid var(--hair); background: #fff; border-radius: 9px; padding: 8px 10px; margin-top: 6px; font: inherit; color: var(--ink); cursor: pointer; }
  #ci .ci-panel .part:hover { border-color: var(--coral); }
  #ci .ci-panel .part b { font-size: 0.84rem; font-weight: 620; line-height: 1.35; }
  #ci .ci-panel .part i { font-style: normal; font: 600 10.5px ui-monospace, monospace; color: var(--ink-mut); }
  #ci .ci-panel .pabout { font-size: 0.8rem; color: var(--ink-mut); margin-top: 12px; }
  #ci .ci-panel .pclsbtn { font: inherit; font-weight: 650; color: var(--ink); background: none; border: 0; border-bottom: 1px dashed var(--coral); padding: 0; cursor: pointer; }
  #ci .ci-panel h3.ptitle { font-size: 1rem; line-height: 1.35; margin: 4px 0; }

  #ci .dot.be, #ci .sw.be { background: var(--roof-be); }
  #ci .dot.ui, #ci .sw.ui { background: var(--roof-ui); }
  #ci .dot.un, #ci .sw.un { background: var(--roof-un); }
  #ci .dot.key, #ci .sw.key { background: var(--roof-key); }

  /* A house with a Java / SSJS article flies a roof flag in that colour
     (world.js). The legend shows them as little pennants — a shape distinct
     from the roof-meaning triangles. The same colours mark each article row in
     the panel, there as a small round dot (.pdot). The `.ci-legend` scope is
     needed so the pennant shape wins over the `.ci-legend .sw` triangle below. */
  #ci .ci-legend .sw.flag { clip-path: polygon(0 0, 100% 42%, 0 72%); border-radius: 0; width: 12px; height: 12px; vertical-align: -1px; }
  #ci .sw.flag.java, #ci .pdot.java { background: #4f86c6; }
  #ci .sw.flag.ssjs, #ci .pdot.ssjs { background: #4fa36b; }
  #ci .pdot.ls { background: #db6a41; }
  #ci .pdot.other { background: #9a958c; }
  #ci .ci-leg-sep { width: 1px; align-self: stretch; margin: 1px 2px; background: var(--hair); }
  #ci .ci-panel .part i .pdot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 5px; vertical-align: 0; }

  #ci .ci-legend { position: absolute; left: 14px; bottom: 12px; z-index: 5; display: flex; gap: 14px; flex-wrap: wrap; background: rgba(255, 248, 244, 0.92); border: 1px solid var(--hair); border-radius: 8px; padding: 7px 12px; font-size: 12px; color: var(--ink-mut); }
  #ci .ci-legend .sw { display: inline-block; width: 14px; height: 10px; border-radius: 2px 2px 0 0; clip-path: polygon(0 100%, 50% 0, 100% 100%); vertical-align: -1px; margin-right: 5px; }

  #ci .ci-hint { display: none; }

  /* The hidden attribute must win over the explicit display on these overlays
     (a higher-specificity display rule otherwise defeats UA [hidden]). */
  #ci .ci-loading[hidden], #ci .ci-fallback[hidden], #ci .ci-panel[hidden], #ci .ci-tip[hidden] { display: none; }

  /* Plates that would collide with a nearer/bigger island's plate shrink to
     their number (scene.js decides); hovering or selecting shows the name. */
  #ci .ci-lbl.compact { padding: 4px 6px; }
  #ci .ci-lbl.compact span, #ci .ci-lbl.compact i { display: none; }
  #ci .ci-lbl.compact:hover span, #ci .ci-lbl.compact.sel span { display: inline; }
  #ci .ci-lbl:hover, #ci .ci-lbl.sel { z-index: 2000 !important; }

  #ci .ci-brand { color: var(--coral); }

  /* Small-screen map tools: a column of small cream buttons (shared look with
     the page's view switch, styled in map.astro). Hidden on wider screens,
     where the title card carries search and reset. */
  #ci .ci-tools { display: none; position: absolute; top: 10px; right: 10px; z-index: 7; flex-direction: column; gap: 8px; }
  #ci .ci-tools button { display: flex; align-items: center; justify-content: center; gap: 5px; width: 68px; height: 42px; padding: 0 8px; border-radius: 12px; border: 1px solid var(--hair);
    background: rgba(255, 248, 244, 0.95); color: var(--ink); font: 600 12.5px/1 system-ui, -apple-system, 'Noto Sans TC', sans-serif; box-shadow: 0 4px 14px rgba(33, 29, 29, 0.12); cursor: pointer; }
  #ci .ci-tools button[aria-expanded='true'], #ci .ci-tools button[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  /* island list: the reference index's numbered rows */
  #ci .ci-panel .plist-isl { display: flex; flex-direction: column; margin-top: 4px; }
  #ci .ci-panel .pisl { display: flex; align-items: center; gap: 10px; text-align: left; border: 0; border-bottom: 1px solid var(--hair); background: transparent; padding: 10px 2px; font: inherit; color: var(--ink); cursor: pointer; }
  #ci .ci-panel .pisl:hover span { color: var(--coral); }
  #ci .ci-panel .pisl b { min-width: 30px; font: italic 600 21px/1 Georgia, 'Times New Roman', serif; color: var(--coral); }
  #ci .ci-panel .plist-empty { margin: 12px 0 0; font-size: 0.84rem; color: var(--ink-mut); }
  #ci .ci-panel .pisl span { flex: 1; font-size: 0.88rem; font-weight: 600; }
  #ci .ci-panel .pisl i { font-style: normal; font: 600 10.5px ui-monospace, monospace; color: var(--ink-mut); }

  /* Small screens: reference-style brand card (big coral brand), the
     tools column on the right, search folded into a button, no legend, and
     the island panel as a bottom sheet. */
  @media (max-width: 760px) {
    #ci { display: block; }
    #ci .ci-stage { position: absolute; inset: 0; }
    #ci .ci-card { top: 10px; left: 10px; max-width: calc(100% - 100px); padding: 10px 14px 11px; gap: 0; }
    #ci .ci-brand { font-size: 24px; }
    #ci .ci-name { font-size: 13px; }
    #ci .ci-stat { margin-top: 7px; padding: 3px 9px; font-size: 10.5px; }
    #ci .ci-stat b { font-size: 13px; }
    #ci .ci-bar { display: none; }
    /* the index folds away: its search opens under the brand card, its
       panel is the bottom sheet */
    #ci .ci-index { display: contents; }
    #ci .ci-ix-head { display: none; }
    #ci.search-open .ci-ix-head { display: block; position: absolute; z-index: 7; top: var(--ci-q-top, 120px); left: 10px; right: 88px; padding: 0; border: 0; }
    #ci.search-open .ci-ix-head > :not(#ci-q) { display: none; }
    #ci.search-open #ci-q { box-shadow: 0 6px 18px rgba(33, 29, 29, 0.14); }
    #ci .ci-tools { display: flex; }
    #ci .ci-pop:not([hidden]) { display: flex; position: absolute; right: 86px; z-index: 9; flex-direction: column; align-items: stretch; gap: 7px; padding: 8px;
      background: rgba(255, 248, 244, 0.97); border: 1px solid var(--hair); border-radius: 12px; box-shadow: 0 8px 22px rgba(33, 29, 29, 0.18); }
    #ci .ci-pop .ci-time button { padding: 7px 11px; font-size: 13px; }
    #ci .ci-pop .ci-bird { justify-content: center; padding: 7px 11px; font-size: 13px; }
    #ci .ci-legend { display: none; }
    #ci .ci-panel { position: absolute; left: 0; right: 0; bottom: 0; z-index: 8; max-height: 64%; padding: 15px 16px 17px; background: var(--paper); border: 1px solid var(--hair); border-radius: 16px 16px 0 0; box-shadow: 0 -10px 34px rgba(33, 29, 29, 0.18); }
    #ci .ci-hint { display: block; position: absolute; bottom: 14px; left: 50%; transform: translateX(-50%); z-index: 5; background: rgba(33, 29, 29, 0.82); color: #fff8f4; font-size: 11.5px; padding: 5px 12px; border-radius: 999px; pointer-events: none; transition: opacity 0.4s; white-space: nowrap; }
  }
  /* Docked layouts where the one row doesn't fit (.bar-col, set by the
     script): as the reference's smaller screens, a column of buttons at the
     right under the view tabs (全景, 檢視 → time / bird's-eye / plates,
     連線, 暫停). Search and the list stay in the docked index. The row is
     only hidden, not removed, so the script can keep measuring it. */
  @media (min-width: 761px) {
    #ci.bar-col .ci-bar { visibility: hidden; pointer-events: none; }
    #ci.bar-col .ci-tools { display: flex; top: 72px; right: 14px; }
    #ci.bar-col .ci-tools [data-act='search'], #ci.bar-col .ci-tools [data-act='list'] { display: none; }
    #ci.bar-col .ci-pop:not([hidden]) { display: flex; position: absolute; right: 92px; z-index: 9; flex-direction: column; align-items: stretch; gap: 7px; padding: 8px;
      background: rgba(255, 248, 244, 0.97); border: 1px solid var(--hair); border-radius: 12px; box-shadow: 0 8px 22px rgba(33, 29, 29, 0.18); }
    #ci.bar-col .ci-pop .ci-time button { padding: 7px 11px; font-size: 13px; }
    #ci.bar-col .ci-pop .ci-bird { justify-content: center; padding: 7px 11px; font-size: 13px; }
  }
  @media (max-width: 640px) {
    #ci .ci-lbl { font-size: 10px; padding: 4px 6px; gap: 4px; }
    #ci .ci-lbl i { display: none; }
  }

  @media (prefers-color-scheme: dark) {
    #ci { --cbg: #0f0f0f; --cpanel: #171717; --cink: #ececec; --cmuted: #9a9a9a; --cline: #2a2a2a; --cgold: #fbbf24; }
  }
  :root[data-theme='dark'] #ci { --cbg: #0f0f0f; --cpanel: #171717; --cink: #ececec; --cmuted: #9a9a9a; --cline: #2a2a2a; --cgold: #fbbf24; }
  :root[data-theme='light'] #ci { --cbg: #faf9f6; --cpanel: #fff; --cink: #1a1a1a; --cmuted: #6b6b6b; --cline: #e2e0d8; --cgold: #d99000; }
</style>

<script>
  function initClassIslands() {
    var root = document.getElementById('ci');
    var dataEl = document.getElementById('ci-data');
    if (!root || !dataEl || root.dataset.ready) return;
    root.dataset.ready = '1';

    var DATA = JSON.parse(dataEl.textContent || '{"nodes":[],"cats":[]}');
    var DS = root.dataset;
    var stage = root.querySelector('.ci-stage');
    var canvas = document.getElementById('ci-canvas');
    var panel = document.getElementById('ci-panel');
    var loadingEl = document.getElementById('ci-loading');
    var fallbackEl = document.getElementById('ci-fallback');
    var hint = document.getElementById('ci-hint');
    var q = document.getElementById('ci-q');
    var api = null;
    // Article language → label (identifiers, same in both languages). The
    // matching door-sign badge colour lives in islands/signs.js (LANG_BADGE).
    var LANG_LABEL = { ls: 'LotusScript', java: 'Java', ssjs: 'SSJS', other: root.dataset.langOther };

    function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function webglOK() {
      try {
        var c = document.createElement('canvas');
        return !!(window.WebGLRenderingContext && (c.getContext('webgl2') || c.getContext('webgl')));
      } catch (e) { return false; }
    }
    function kindOf(n) { return n.key ? 'key' : !n.url ? 'un' : n.ui ? 'ui' : 'be'; }

    var NODE = {};
    DATA.nodes.forEach(function (n) { NODE[n.id] = n; });

    // Wider screens dock the panel in the index on the right, where it always
    // shows something (the island list when nothing else); phones keep it as
    // a bottom sheet that closes.
    var dockMQ = window.matchMedia('(min-width: 761px)');
    function docked() { return dockMQ.matches; }
    var panelMode = null; // 'list' | 'island' | 'card'
    var curCluster = null;
    function showHome() {
      if (docked()) renderIslandList();
      else { panel.hidden = true; panel.innerHTML = ''; panelMode = null; }
    }

    // Class overview and article preview: the same panel, showing the basics
    // first; the article itself is one more click away ("Open article →").
    function closeCard() {
      if (api) api.focusClass(null);
      // back to the island it came from, else home
      if (curCluster) renderPanel(curCluster);
      else showHome();
    }
    function openCard(html, node) {
      panel.innerHTML = '<button class="pclose" aria-label="' + esc(DS.close) + '">×</button>' + html;
      panel.hidden = false;
      panelMode = 'card';
      panel.scrollTop = 0;
      panel.querySelector('.pclose').addEventListener('click', closeCard);
      Array.prototype.forEach.call(panel.querySelectorAll('[data-cat]'), function (b) {
        b.addEventListener('click', function () { if (api) api.select(b.dataset.cat); });
      });
      Array.prototype.forEach.call(panel.querySelectorAll('[data-class]'), function (b) {
        b.addEventListener('click', function () { showClass(NODE[b.dataset.class]); });
      });
      Array.prototype.forEach.call(panel.querySelectorAll('[data-article]'), function (b) {
        b.addEventListener('click', function () { showArticle(node, +b.dataset.article); });
      });
      // keep the class's relation lines lit while its card is open
      if (api) api.focusClass(node.id);
    }
    function articleRow(a, i) {
      var ll = LANG_LABEL[a.lang] || LANG_LABEL.ls;
      return '<button class="part" data-article="' + i + '"><b>' + esc(a.title) + '</b><i><span class="pdot ' + esc(a.lang || 'ls') + '"></span>' + esc(ll) + ' · ' + esc(a.date) + '</i></button>';
    }
    function showClass(n) {
      if (!n) return;
      // XPages island buildings are posts, not classes: show the article card.
      if (n.island) return showArticle(n, 0);
      var arts = n.articles || [];
      var tags = '<span class="ptag"><span class="dot ' + (n.ui ? 'ui' : 'be') + '"></span>' + esc(n.ui ? DS.tipUi : DS.tipBe) + '</span>' +
        (n.key ? '<span class="ptag"><span class="dot key"></span>' + esc(DS.tipKey) + '</span>' : '');
      var nl = api ? api.linkCount(n.id) : 0;
      if (nl) tags += '<span class="ptag">' + esc(DS.tipLinks.replace('{n}', nl)) + '</span>';
      openCard(
        '<div class="pkind">' + esc(DS.cardClass) + ' <button class="pcat" data-cat="' + esc(n.cat) + '">' + esc(n.cat) + '</button></div>' +
        '<h3>' + esc(n.name) + '</h3>' +
        '<div class="ptags">' + tags + '</div>' +
        '<p class="pdesc' + (n.desc ? '' : ' none') + '">' + esc(n.desc || DS.noDesc) + '</p>' +
        (arts.length
          ? '<a class="pgo" href="' + esc(arts[0].url) + '">' + esc(DS.goArticle) + '</a>' +
            '<div class="psec"><div class="prel-lbl">' + esc(DS.classArticles) + '</div>' + arts.map(articleRow).join('') + '</div>'
          : '<p class="pdesc none">' + esc(DS.noArticle) + '</p>'),
        n
      );
    }
    function showArticle(n, i) {
      var a = n && n.articles && n.articles[i];
      if (!a) return;
      var more = n.articles.map(function (b, j) { return j === i ? '' : articleRow(b, j); }).join('');
      var ll = LANG_LABEL[a.lang] || LANG_LABEL.ls;
      openCard(
        '<div class="pkind">' + esc(DS.cardArticle) + ' · ' + esc(ll) + '</div>' +
        '<h3 class="ptitle">' + esc(a.title) + '</h3>' +
        '<div class="pmeta">' + esc(a.date) + '</div>' +
        '<p class="pdesc">' + esc(a.desc) + '</p>' +
        '<a class="pgo" href="' + esc(a.url) + '">' + esc(DS.goArticle) + '</a>' +
        (n.island
          ? '<div class="pabout">' + esc(n.cat) + '</div>'
          : '<div class="pabout">' + esc(DS.about) + ' <button class="pclsbtn" data-class="' + esc(n.id) + '">' + esc(n.name) + '</button> · ' + esc(n.cat) + '</div>') +
        (more ? '<div class="psec"><div class="prel-lbl">' + esc(DS.moreArticles) + '</div>' + more + '</div>' : ''),
        n
      );
    }

    // Right-hand panel listing the selected island's classes.
    function renderPanel(cluster) {
      if (api) api.focusClass(null);
      curCluster = cluster || null;
      if (!cluster) { showHome(); return; }
      panelMode = 'island';
      var rows = cluster.members.map(function (n) {
        var k = kindOf(n);
        return '<button class="pcls' + (n.url ? '' : ' un') + '" data-id="' + esc(n.id) + '">' +
          '<span class="dot ' + k + '"></span><span class="nm">' + esc(n.name) + '</span>' +
          (n.key ? '<span class="st">★</span>' : '') + (n.url ? '<span class="go">→</span>' : '') + '</button>';
      }).join('');
      // Related islands: ⇄ = a bridge goes there directly, ⋯ = reached on foot via other islands
      var rel = (cluster.relations || []).map(function (r) {
        return '<button class="prel-chip' + (r.bridged ? ' br' : '') + '" data-cat="' + esc(r.cat) + '" title="' + esc(r.bridged ? DS.relBridge : DS.relWalk) + '">' +
          '<span class="ic">' + (r.bridged ? '⇄' : '⋯') + '</span>' + esc(r.cat) + '<i>' + r.n + '</i></button>';
      }).join('');
      panel.innerHTML =
        '<button class="pclose" aria-label="' + esc(DS.close) + '">×</button>' +
        '<div class="pnum">' + String(cluster.num).padStart(2, '0') + '</div>' +
        '<h3>' + esc(cluster.cat) + '</h3>' +
        '<div class="pmeta">' + cluster.count + esc(cluster.members[0] && cluster.members[0].island ? DS.countIsland : DS.count) + '</div>' +
        '<div class="plist">' + rows + '</div>' +
        (rel ? '<div class="prel"><div class="prel-lbl">' + esc(DS.relTitle) + '</div><div class="prel-key">⇄ ' + esc(DS.relBridge) + ' · ⋯ ' + esc(DS.relWalk) + '</div><div class="prel-chips">' + rel + '</div></div>' : '');
      panel.hidden = false;
      panel.scrollTop = 0;
      panel.querySelector('.pclose').addEventListener('click', doReset);
      Array.prototype.forEach.call(panel.querySelectorAll('.prel-chip'), function (chip) {
        chip.addEventListener('click', function () { if (api) api.select(chip.dataset.cat); });
      });
      Array.prototype.forEach.call(panel.querySelectorAll('.pcls'), function (btn) {
        // pointing at a class row lights up that class's relation lines
        function on() { if (api) api.focusClass(btn.dataset.id); }
        function off() { if (api) api.focusClass(null); }
        btn.addEventListener('mouseenter', on);
        btn.addEventListener('focus', on);
        btn.addEventListener('mouseleave', off);
        btn.addEventListener('blur', off);
        btn.addEventListener('click', function () { showClass(NODE[btn.dataset.id]); });
      });
    }

    var booted = false;
    function boot() {
      if (booted || !root.offsetParent) return; // wait until the tab is visible
      booted = true;
      if (!webglOK()) { fallbackEl.hidden = false; return; }
      loadingEl.hidden = false;
      import('./islands/scene.js').then(function (mod) {
        api = mod.createIslandScene({
          canvas: canvas,
          stage: stage,
          labelsEl: document.getElementById('ci-labels'),
          tipEl: document.getElementById('ci-tip'),
          data: DATA,
          strings: { be: DS.tipBe, ui: DS.tipUi, key: DS.tipKey, un: DS.tipUn, info: DS.tipInfo, article: DS.tipArticle, preview: DS.tipPreview, rel: DS.tipRel, path: DS.tipPath, more: DS.tipMore, links: DS.tipLinks, langLabels: LANG_LABEL },
          onSelect: renderPanel,
          onClass: showClass,
          onArticle: showArticle,
          onTime: syncModes, // the light followed the clock into another time of day
        });
        loadingEl.hidden = true;
        if (q.value) api.filter(q.value);
        syncModes();
        if (docked() && panel.hidden) showHome();
        if (hint && hint.dataset.hint && window.matchMedia && window.matchMedia('(max-width:640px)').matches) {
          hint.textContent = hint.dataset.hint;
          setTimeout(function () { hint.style.opacity = '0'; }, 4200);
        }
      }).catch(function (err) {
        loadingEl.hidden = true;
        fallbackEl.hidden = false;
        console.error('[ClassIslands] could not start the 3D view', err);
      });
    }

    q.addEventListener('input', function () {
      if (!api) return;
      api.filter(q.value);
      if (panelMode === 'list') renderIslandList();
    });

    // Small-screen tools column: overview, search (folds the search field open
    // under the title card; closing it clears the search) and the island list.
    var searchBtn = root.querySelector('.ci-tools [data-act="search"]');
    var card = root.querySelector('.ci-card');
    function setSearch(open) {
      // the field opens just under the brand card
      if (open) root.style.setProperty('--ci-q-top', (card.offsetTop + card.offsetHeight + 8) + 'px');
      root.classList.toggle('search-open', open);
      searchBtn.setAttribute('aria-expanded', String(open));
      if (open) q.focus();
      else if (q.value) {
        q.value = '';
        if (api) api.filter('');
        if (panelMode === 'list') renderIslandList();
      }
    }
    function renderIslandList() {
      if (!api) return;
      // a search narrows the list to islands with a matching class
      var term = q.value.trim().toLowerCase();
      var rows = api.clusters.filter(function (c) {
        return !term || c.cat.toLowerCase().indexOf(term) >= 0 || c.members.some(function (m) { return m.name.toLowerCase().indexOf(term) >= 0 || m.id.toLowerCase().indexOf(term) >= 0; });
      }).map(function (c) {
        return '<button class="pisl" data-cat="' + esc(c.cat) + '"><b>' + String(c.num).padStart(2, '0') + '</b><span>' + esc(c.cat) + '</span><i>' + c.count + '</i></button>';
      }).join('');
      // docked, the list is the panel's home and has nothing to close
      panel.innerHTML = (docked() ? '' : '<button class="pclose" aria-label="' + esc(DS.close) + '">×</button>') +
        '<h3>' + esc(DS.listTitle) + '</h3>' +
        (rows ? '<div class="plist-isl">' + rows + '</div>' : '<p class="plist-empty">' + esc(DS.noMatch) + '</p>');
      panel.hidden = false;
      panelMode = 'list';
      var x = panel.querySelector('.pclose');
      if (x) x.addEventListener('click', function () { panel.hidden = true; panel.innerHTML = ''; panelMode = null; });
      Array.prototype.forEach.call(panel.querySelectorAll('.pisl'), function (b) {
        b.addEventListener('click', function () { api.select(b.dataset.cat); });
      });
    }
    // 檢視: time of day + bird's-eye in a small pop-out beside the column
    var viewBtn = root.querySelector('.ci-tools [data-act="view"]');
    var viewPop = document.getElementById('ci-viewpop');
    function setViewPop(open) {
      viewPop.hidden = !open;
      viewBtn.setAttribute('aria-expanded', String(open));
      if (open) viewPop.style.top = (viewBtn.offsetParent.offsetTop + viewBtn.offsetTop) + 'px';
    }
    document.addEventListener('pointerdown', function (e) {
      if (!viewPop.hidden && !viewPop.contains(e.target) && !viewBtn.contains(e.target)) setViewPop(false);
    });
    Array.prototype.forEach.call(root.querySelectorAll('.ci-tools button'), function (b) {
      b.addEventListener('click', function () {
        if (b.dataset.act === 'home') doReset();
        else if (b.dataset.act === 'search') setSearch(!root.classList.contains('search-open'));
        else if (b.dataset.act === 'list') renderIslandList();
        else if (b.dataset.act === 'view') setViewPop(viewPop.hidden);
        // phones: all lines on / back to the selected island's
        else if (b.dataset.act === 'links') { if (api) { api.setLinks(api.getLinks() === 'all' ? 'focus' : 'all'); syncModes(); } }
      });
    });
    // wide-screen toolbar: overview and name plates (time of day, relation
    // lines, pause and bird's-eye are bound below with their phone twins)
    root.querySelector('.ci-icons [data-act="home"]').addEventListener('click', doReset);
    Array.prototype.forEach.call(root.querySelectorAll('[data-act="plates"]'), function (btn) {
      btn.addEventListener('click', function () {
        root.classList.toggle('no-plates');
        syncModes();
      });
    });
    // crossing the phone/tablet breakpoint: dock or fold the panel
    dockMQ.addEventListener('change', function () {
      if (docked()) { root.classList.remove('search-open'); if (panel.hidden) showHome(); else if (panelMode === 'list') renderIslandList(); }
      else if (panelMode === 'list') showHome();
    });

    // Time of day and bird's-eye: card controls (wider screens) and tools
    // column (phones) drive the same scene state; syncModes mirrors it back.
    var TIME_TXT = JSON.parse(DS.times || '{}');
    function syncModes() {
      if (!api) return;
      var t = api.getTime(), b = api.isBird(), lm = api.getLinks(), p = api.isPaused();
      Array.prototype.forEach.call(root.querySelectorAll('.ci-time button[data-time]'), function (btn) {
        btn.classList.toggle('on', btn.dataset.time === t);
        btn.setAttribute('aria-pressed', String(btn.dataset.time === t));
      });
      viewBtn.title = TIME_TXT[t] || t;
      Array.prototype.forEach.call(root.querySelectorAll('[data-act="bird"]'), function (btn) { btn.setAttribute('aria-pressed', String(b)); });
      Array.prototype.forEach.call(root.querySelectorAll('[data-links]'), function (btn) {
        btn.classList.toggle('on', btn.dataset.links === lm);
        btn.setAttribute('aria-pressed', String(btn.dataset.links === lm));
      });
      root.querySelector('.ci-tools [data-act="links"]').setAttribute('aria-pressed', String(lm === 'all'));
      var plates = !root.classList.contains('no-plates');
      Array.prototype.forEach.call(root.querySelectorAll('[data-act="plates"]'), function (btn) { btn.setAttribute('aria-pressed', String(plates)); });
      Array.prototype.forEach.call(root.querySelectorAll('[data-act="pause"]'), function (btn) {
        btn.setAttribute('aria-pressed', String(p));
        btn.querySelector('.ci-pause-name').textContent = p ? DS.play : DS.pause;
      });
    }
    function doReset() {
      if (!api) return;
      api.reset(); // also leaves bird's-eye
      syncModes();
    }
    Array.prototype.forEach.call(root.querySelectorAll('.ci-time button[data-time]'), function (btn) {
      btn.addEventListener('click', function () { if (api) { api.setTime(btn.dataset.time); syncModes(); } });
    });
    Array.prototype.forEach.call(root.querySelectorAll('[data-links]'), function (btn) {
      btn.addEventListener('click', function () { if (api) { api.setLinks(btn.dataset.links); syncModes(); } });
    });
    Array.prototype.forEach.call(root.querySelectorAll('[data-act="pause"]'), function (btn) {
      btn.addEventListener('click', function () { if (api) { api.setPaused(!api.isPaused()); syncModes(); } });
    });
    Array.prototype.forEach.call(root.querySelectorAll('[data-act="bird"]'), function (btn) {
      btn.addEventListener('click', function () { if (api) { api.setBird(!api.isBird()); syncModes(); } });
    });
    document.getElementById('ci-fb-btn').addEventListener('click', function () {
      var dirTab = document.querySelector('.map-tab[data-view="dir"]');
      if (dirTab) dirTab.click();
    });

    // Docked layouts: keep the one-row toolbar only while it clears the view
    // tabs; otherwise switch to the column of buttons (.bar-col).
    var bar = root.querySelector('.ci-bar');
    function fitBar() {
      if (!root.offsetParent) return;
      var fits = true;
      if (docked()) {
        var tabs = document.querySelector('.map-tabs');
        var tr = tabs && tabs.getBoundingClientRect();
        var limit = tr && tr.width ? tr.left : stage.getBoundingClientRect().right;
        fits = bar.getBoundingClientRect().right + 12 <= limit;
      }
      root.classList.toggle('bar-col', !fits);
      if (fits && docked()) setViewPop(false); // the pop-out belongs to the column
    }
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitBar);

    // map.astro dispatches a synthetic resize when a tab is shown; that is our
    // cue to load three.js the first time the islands tab becomes visible.
    boot();
    fitBar();
    window.addEventListener('resize', function () { boot(); fitBar(); });
  }
  document.addEventListener('astro:page-load', initClassIslands);
</script>
